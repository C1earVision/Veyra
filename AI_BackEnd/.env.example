# Environment variables for AI backend
# Database points to Supabase

# Must match BackEnd JWT_SECRET (validates login tokens on /query and /data-sources)
JWT_SECRET=your-jwt-secret-here

# Local Ollama (default model — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1

GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key

# Supabase connection
DATABASE_SERVER=aws-0-xx.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER_NAME=postgres.xxxxxxxxxxxx
DATABASE_PASS=your-database-password
DATABASE_SSL=true

# Supabase Storage (persists uploaded datasets across serverless cold starts)
# Required for production deployments; optional for local development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Full HTTPS URLs (required in production)
API_URL=https://your-node-backend.vercel.app/api/v1
AI_BACKEND_URL=https://your-ai-backend.onrender.com
